# PlatePilote — configuration Flutter
#
# The APK reads its API endpoint at compile time; .env is not bundled.
# Local development:
#   flutter run --dart-define=PLATEPILOT_API_BASE_URL=http://10.0.2.2:8081/api/v1
# Release builds use the repository variable PLATEPILOT_API_BASE_URL.
#
# Never place credentials or private API keys in --dart-define or this file.
PLATEPILOT_API_BASE_URL=https://api.platepilote.com/api/v1
