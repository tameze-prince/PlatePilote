# PlatePilote — Flutter build configuration
#
# The app does not bundle or load .env files. Configure the API endpoint at
# build/run time:
#   flutter run --dart-define=PLATEPILOT_API_BASE_URL=http://10.0.2.2:8081/api/v1
#   flutter build apk --release --dart-define=PLATEPILOT_API_BASE_URL=https://api.example.com/api/v1
#
# The production release workflow reads the GitHub repository variable
# PLATEPILOT_API_BASE_URL and requires HTTPS.
#
# This file is documentation only. Do not put secrets in the Flutter client.
