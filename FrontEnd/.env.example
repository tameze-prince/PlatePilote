# PlatePilote — Variables d'environnement (FrontEnd)
#
# Copier ce fichier en `.env` et renseigner les valeurs.
# NE JAMAIS commit un `.env` rempli (secret).
#
# Méthodes de définition (par ordre de priorité) :
#   1. --dart-define=KEY=value (CLI)
#   2. fichier .env (lu via flutter_dotenv, à charger dans main.dart)
#   3. échec explicite au démarrage (StateError)

# URL de base de l'API REST (obligatoire en prod et CI)
PLATEPILOT_API_BASE_URL=https://api.platepilote.com/api/v1

# DSN Sentry — surveillance erreurs (optionnel)
SENTRY_DSN=

# ID du projet Firebase (optionnel, requis si push notifications activées)
FIREBASE_PROJECT_ID=
