# ══════════════════════════════════════════════════════════════
# PLATEPILOTE — Environment Variables (.env)
# ══════════════════════════════════════════════════════════════
# Copy to .env and fill values:
#   cp .env.example .env
# ══════════════════════════════════════════════════════════════

# ═══ DATABASE ═════════════════════════════════════════════════
DB_URL=jdbc:postgresql://localhost:***@platepilote.com>
DB_USERNAME=postgres
DB_PASSWORD=postgres
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
BREVO_SMTP_USERNAME=
BREVO_SMTP_KEY=
EMAIL_VERIFICATION_FROM=PlatePilote <no-reply@platepilote.com>
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPIRATION_HOURS=24

# ═══ JWT ═════════════════════════════════════════════════════
JWT_SECRET=Y2hhbmdlLXRoaXMtdG8tYS1sb25nLXNlY3VyZS1rZXktaW4tcHJvZHVjdGlvbi1lbnZpcm9ubWVudC1wbGVhc2U=
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# ═══ OAUTH2 ═══════════════════════════════════════════════════
GOOGLE_OAUTH_CLIENT_IDS=
GOOGLE_OAUTH_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_OAUTH_ISSUERS=https://accounts.google.com,accounts.google.com
APPLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_JWK_SET_URI=https://appleid.apple.com/auth/keys
APPLE_OAUTH_ISSUERS=https://appleid.apple.com
FACEBOOK_OAUTH_CLIENT_ID=
FACEBOOK_OAUTH_GRAPH_URI=https://graph.facebook.com/v19.0
FACEBOOK_OAUTH_CLIENT_SECRET=

# ═══ CLOUDFLARE R2 (Images) ═════════════════════════════════
R2_ENDPOINT=
R2_REGION=auto
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=platepilote-images
R2_PUBLIC_URL_TEMPLATE=https://pub-{hash}.r2.dev

# ═══ CORS ════════════════════════════════════════════════════
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081

# ═══ STRIPE BILLING ══════════════════════════════════════════
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings/billing
BILLING_FREE_TRIAL_DAYS=30
BILLING_PAST_DUE_GRACE_DAYS=3

# ═══ EXTERNAL APIs ═══════════════════════════════════════════
USDA_API_KEY=
THEMEALDB_API_KEY=1
EDAMAM_APP_ID=
EDAMAM_APP_KEY=
SPOONACULAR_API_KEY=
NUTRITIONIX_APP_ID=
NUTRITIONIX_APP_KEY=
UPCITEMDB_API_KEY=
BARCODE_LOOKUP_API_KEY=
CHOMP_API_KEY=
SERP_API_KEY=
RECIPEAPI_API_KEY=
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ═══ AI SERVICE ══════════════════════════════════════════════
#
# PlatePilote supports multiple AI providers via the AiProvider interface.
# All listed providers offer GENEROUS FREE TIER (no credit card required).
#
# ── PRIMARY (recommended, $0 free tier) ─────────────────────
# NVIDIA NIM → openai-compatible api, free credits at build.nvidia.com
AI_PROVIDER=nvidia-nim
NVIDIA_NIM_API_KEY=nvapi-...3
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_NIM_MODEL=minimaxai/minimax-m3
# Long-context version (16k tokens):
# NVIDIA_NIM_MODEL=moonshotai/kimi-k2.6
# Fast & cheap (titles, short completions):
# NVIDIA_NIM_MODEL=meta/llama-3.1-8b-instruct
#
# ── ALTERNATE PROVIDERS (also free or near-free) ──────────────
# Groq Cloud — ultra-fast Llama / Mixtral inference
# GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxx
# GROQ_MODEL=llama-3.1-70b-versatile
#
# Google AI Studio — Gemini 1.5 Flash (free tier: 15 req/min)
# GOOGLE_AI_API_KEY=AIzaSyxxxxxxxxxxxxxxxxxx
# GOOGLE_AI_MODEL=gemini-1.5-flash
#
# OpenRouter — 100+ free models in one API (no credit card)
# OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxxxxxxxxxx
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
#
# ── LEGACY (kept for backwards compat) ───────────────────────
AI_SERVICE_URL=http://localhost:8086/api/v1/ai

# ═══ PROFILES ════════════════════════════════════════════════
SPRING_PROFILES_ACTIVE=dev