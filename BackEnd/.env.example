# PlatePilote Backend environment template.
# Copy this file to .env for local development. Keep .env private.

# Runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Database
POSTGRES_DB=platepilote
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Generate a strong Base64 secret before production.
JWT_SECRET=change-me-base64-encoded-256-bit-secret
JWT_EXPIRATION=3600000
JWT_REFRESH_EXPIRATION=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081

# Food APIs
USDA_API_KEY=
THEMEALDB_API_KEY=1

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings/billing
BILLING_FREE_TRIAL_DAYS=30
BILLING_PAST_DUE_GRACE_DAYS=3

# OAuth2 Login
# Comma-separated if you have multiple app client IDs.
GOOGLE_OAUTH_CLIENT_IDS=
APPLE_OAUTH_CLIENT_IDS=

# ==========================================
# EMAIL CONFIGURATION
# ==========================================
# LOCAL DEV (Mailpit via docker-compose) — emails captured at http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=

# PRODUCTION (Brevo SMTP) — swap the above values when deploying
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# BREVO_SMTP_USERNAME=your-brevo-smtp-login
# BREVO_SMTP_KEY=xsmtpsib-your-api-key
# MAIL_USERNAME=your-brevo-smtp-login
# MAIL_PASSWORD=your-brevo-smtp-key

EMAIL_VERIFICATION_FROM=PlatePilote <no-reply@platepilote.com>
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPIRATION_HOURS=24
# false keeps registration usable if SMTP is misconfigured; set true in strict production.
EMAIL_VERIFICATION_FAIL_ON_SEND_ERROR=false
