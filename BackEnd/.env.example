# PlatePilote Backend environment template.
# Copy this file to .env for local development. Keep .env private.

# Runtime
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8081

# Database
POSTGRES_DB=platepilote
DB_USERNAME=postgres
DB_PASSWORD=change-me

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
# Generate a strong Base64 secret before production: openssl rand -base64 32
JWT_SECRET=change-me-base64-encoded-256-bit-secret

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:59043

# Food APIs
USDA_API_KEY=
THEMEALDB_API_KEY=1

# Stripe Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
STRIPE_PORTAL_RETURN_URL=http://localhost:3000/settings/billing
BILLING_FREE_TRIAL_DAYS=30
BILLING_PAST_DUE_GRACE_DAYS=3

# ==========================================
# EMAIL (Brevo SMTP)
# ==========================================
# LOCAL DEV — run Mailpit via Docker: docker run -p 1025:1025 -p 8025:8025 mailpit
# emails captured at http://localhost:8025
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true

# PRODUCTION — uncomment and fill in your Brevo credentials:
# Brevo SMTP relay: smtp-relay.brevo.com port 587 (STARTTLS required)
# BREVO_SMTP_USERNAME=your-brevo-smtp-login
# BREVO_SMTP_KEY=xsmtpsib-your-api-key
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USERNAME=your-brevo-smtp-login
# MAIL_PASSWORD=your-brevo-smtp-key
# MAIL_SMTP_AUTH=true
# MAIL_SMTP_STARTTLS=true

EMAIL_VERIFICATION_FROM=PlatePilote <no-reply@platepilote.com>
EMAIL_VERIFICATION_URL=http://localhost:3000/verify-email
EMAIL_VERIFICATION_EXPIRATION_HOURS=24
# false = registration stays usable if SMTP fails; true = strict production mode
EMAIL_VERIFICATION_FAIL_ON_SEND_ERROR=false

# ==========================================
# OAUTH2 / SOCIAL LOGIN
# ==========================================
# GOOGLE — https://console.cloud.google.com
#   Create "Web application" OAuth 2.0 Client ID.
#   Authorized JavaScript origins: http://localhost:8081 (dev), https://your-domain.com (prod)
#   Authorized redirect URI: https://oauth2.googleapis.com/token
#   The id_token (JWT) is validated server-side using Google's JWK endpoint.
#   Add multiple client IDs (web, iOS, Android) comma-separated:
GOOGLE_OAUTH_CLIENT_IDS=your-google-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_JWK_SET_URI=https://www.googleapis.com/oauth2/v3/certs
GOOGLE_OAUTH_ISSUERS=https://accounts.google.com,accounts.google.com

# APPLE — https://developer.apple.com
#   App ID capability: "Sign in with Apple"
#   Services ID: create a Web application with redirect URI https://appleid.apple.com/auth/token
#   Keys: create a key with "Sign in with Apple" capability
#   Multiple client IDs (bundle identifiers, Service ID) comma-separated:
APPLE_OAUTH_CLIENT_IDS=com.yourteam.PlatePilote
APPLE_OAUTH_JWK_SET_URI=https://appleid.apple.com/auth/keys
APPLE_OAUTH_ISSUERS=https://appleid.apple.com

# FACEBOOK — https://developers.facebook.com
#   Add "Facebook Login" product. Set Valid OAuth Redirect URIs:
#     http://localhost:3000/oauth-callback/facebook (dev)
#     https://your-domain.com/oauth-callback/facebook (prod)
#   The access token is validated server-side via Facebook Graph API.
FACEBOOK_OAUTH_CLIENT_ID=your-facebook-app-id
FACEBOOK_OAUTH_CLIENT_SECRET=your-facebook-app-secret
FACEBOOK_OAUTH_GRAPH_URI=https://graph.facebook.com/v19.0
